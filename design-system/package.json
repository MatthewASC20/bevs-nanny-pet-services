{
  "name": "@bevs/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Bev's Nanny & Pet Services design system \u2014 React components extracted from the live site, with the site's own stylesheet as the single source of truth.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "extract-css": "node scripts/extract-css.mjs",
    "build": "tsup && npm run extract-css",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}